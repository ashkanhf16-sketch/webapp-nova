{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webapp-nova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "84b8b9d8-310d-4fe4-b06a-84bb58640028","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "189b5d989e144f129f25b4d434adb4b3" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
